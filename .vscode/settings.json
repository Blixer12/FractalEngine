{
    "workbench.colorCustomizations": {
        /* --- Normal Windows Console Colors (0;3x codes) --- */
        "terminal.ansiRed": "#ff0000cb",       // Windows Dark Red (Color Index 4)
        "terminal.ansiYellow": "#808000",    // Windows Dark Yellow/Amber
        "terminal.ansiGreen": "#008000",     // Windows Dark Green
        "terminal.ansiCyan": "#008080",      // Windows Dark Cyan
        "terminal.ansiWhite": "#ffffff",     // Windows Standard White (Color Index 7)

        /* --- Bright Windows Console Colors (1;3x codes) --- */
        "terminal.ansiBrightRed": "#ff5b5b",   // Windows Bright Red (Color Index 12)
        "terminal.ansiBrightYellow": "#ffee00",// Windows Bright Yellow (Color Index 6)
        "terminal.ansiBrightGreen": "#00FF00", // Windows Bright Green (Color Index 10)
        "terminal.ansiBrightCyan": "#00FFFF",  // Windows Bright Cyan (Color Index 11)
        "terminal.ansiBrightWhite": "#FFFFFF"  // Windows Pure White
    },
    "terminal.integrated.drawBoldTextInBrightColors": true,

    /* --- Debug Console Typography & Layout Tweaks --- */
    "debug.console.fontFamily": "Consolas",   // Standard Windows terminal font style
    "debug.console.fontSize": 14,             // Clear text sizing for logging data density
    "debug.console.lineHeight": 20,           // Clean vertical spacing between text lines
    "debug.console.wordWrap": true,           // Prevents long assert statements from clipping off-screen
    
    /* --- Debug Pipeline Behaviors --- */
    "debug.internalConsoleOptions": "neverOpen" // Keeps focus on your active workspace layout choice
}