{
    "tasks": [
        {
            "type": "shell",
            "label": "Build Engine",
            "windows": {
                "command": "${workspaceFolder}/Engine/Build.bat"
            },
            "linux": {
                "command": "${workspaceFolder}/Engine/Build.sh"
            },
            "options": {
                "cwd": "${workspaceFolder}/Engine"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        },
        {
            "type": "shell",
            "label": "Build Launcher",
            "windows": {
                "command": "${workspaceFolder}/Launcher/Build.bat"
            },
            "linux": {
                "command": "${workspaceFolder}/Launcher/Build.sh"
            },
            "options": {
                "cwd": "${workspaceFolder}/Launcher"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "Build Unit Tests",
            "windows": {
                "command": "${workspaceFolder}/Tests/Build.bat"
            },
            "linux": {
                "command": "${workspaceFolder}/Tests/Build.sh"
            },
            "options": {
                "cwd": "${workspaceFolder}/Tests"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "Clean Everything",
            "windows": {
                "command": "${workspaceFolder}/CleanAll.bat"
            },
            "linux": {
                "command": "${workspaceFolder}/CleanAll.sh"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build"
        },
        {
            "type": "shell",
            "label": "Build Everything",
            "windows": {
                "command": "${workspaceFolder}/BuildAll.bat"
            },
            "linux": {
                "command": "${workspaceFolder}/BuildAll.sh"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "Post Build",
            "windows": {
                "command": "${workspaceFolder}/PostBuild.bat"
            },
            "linux": {
                "command": "${workspaceFolder}/PostBuild.sh"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build"
        }
    ],
    "version": "2.0.0"
}