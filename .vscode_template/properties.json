{
    "project": {
        "name": "Fractal Engine",
        "version": "1.0.0",
        "language": "C23",
        "compiler": "MSVC"
    },
    "build_configurations": {
        "Debug": {
            "preprocessor_definitions": [
                "_DEBUG",
                "FDEVELOPMENT=1",
                "FRELEASE=0"
            ],
            "compiler_flags": [
                "/W4",
                "/WX",
                "/Zc:preprocessor",
                "/std:clatest"
            ]
        },
        "Release": {
            "preprocessor_definitions": [
                "NDEBUG",
                "FDEVELOPMENT=0",
                "FRELEASE=1"
            ],
            "compiler_flags": [
                "/O2",
                "/W4",
                "/WX",
                "/Zc:preprocessor",
                "/std:clatest"
            ]
        }
    },
    "logging_defaults": {
        "buffer_sizes": {
            "temp_buffer_bytes": 32768,
            "final_buffer_bytes": 32768
        },
        "compile_time_switches": {
            "LOG_WARN_ENABLED": true,
            "LOG_INFO_ENABLED": true,
            "LOG_DEBUG_ENABLED": true,
            "LOG_TRACE_ENABLED": true
        }
    }
}